<?xml version="1.0" encoding="UTF-8"?>
<!-- PVS runner transport profile (2026-08-14 실측): with host net+ipc shared,
     SUT↔SUT SHM delivers but runner↔SUT SHM silently drops user data while
     discovery still succeeds (topic list shows everything, echo receives
     nothing — the H-B2 shape again). UDP-only on the runner side restores
     delivery; the SUT keeps its own transports (locators are negotiated per
     pair). Applies to harness processes only — do not export this into the
     SUT compose environment. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>udp_only</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="udp_only_participant" is_default_profile="true">
    <rtps>
      <userTransports><transport_id>udp_only</transport_id></userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
