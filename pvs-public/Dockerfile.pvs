# PVS v2 test-harness image .
# ROS 2 base so rclpy + pail_msgs are importable for the live orchestrator,
# Rogue Actor, Safety Adapter and Mock HAL nodes. Pure-python verifiers and the
# verdict engine also run here for the CI (insecure) profile.
FROM ros:humble-ros-base

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3-pip iptables libfaketime curl ca-certificates gnupg \
    && rm -rf /var/lib/apt/lists/*

# docker CLI + compose plugin: the live orchestrator drives the SUT stack itself
# (backend_live.reset_state -> `docker compose up -d --force-recreate`) and the
# ChaosMonkey uses the docker SDK against the mounted /var/run/docker.sock.
RUN install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu jammy stable" > /etc/apt/sources.list.d/docker.list \
    && apt-get update && apt-get install -y --no-install-recommends \
        docker-ce-cli docker-compose-plugin \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /pvs
COPY requirements.txt /pvs/requirements.txt
RUN python3 -m pip install --no-cache-dir -r requirements.txt

# pail_msgs interfaces (for rclpy nodes) are built from the mounted workspace at
# runtime: `source /opt/ros/humble/setup.bash && colcon build`. Kept out of the
# image so the harness tracks the SUT's message definitions.
COPY . /pvs

# gRPC python stubs are generated at build/run from ../proto (see gen_grpc_stubs.md).
ENTRYPOINT ["python3", "-m", "pytest"]
