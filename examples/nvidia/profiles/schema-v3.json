{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "target",
    "platform",
    "runtime",
    "transport",
    "endpoint",
    "security",
    "evidence",
    "resources"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 3
    },
    "profile_id": {
      "type": "string",
      "pattern": "[a-z][a-z0-9-]{2,63}"
    },
    "target": {
      "type": "string",
      "enum": [
        "mock",
        "jetson"
      ]
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arch",
        "board",
        "l4t_major",
        "ros"
      ],
      "properties": {
        "arch": {
          "type": "string",
          "enum": [
            "any",
            "aarch64",
            "x86_64"
          ]
        },
        "board": {
          "type": "string",
          "enum": [
            "none",
            "orin-nano"
          ]
        },
        "l4t_major": {
          "type": "integer",
          "enum": [
            0,
            36
          ]
        },
        "ros": {
          "type": "string",
          "enum": [
            "humble"
          ]
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "gpu"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "isolated-synthetic"
          ]
        },
        "gpu": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "transport": {
      "type": "string",
      "enum": [
        "isolated-local-dds"
      ]
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "model_timeout_ms"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "ros-synthetic"
          ]
        },
        "model_timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "strategy"
      ],
      "properties": {
        "enabled": {
          "type": "boolean",
          "const": true
        },
        "strategy": {
          "type": "string",
          "enum": [
            "Enforce"
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hardware_verified",
        "support_status"
      ],
      "properties": {
        "hardware_verified": {
          "type": "boolean",
          "const": false
        },
        "support_status": {
          "type": "string",
          "enum": [
            "UNVERIFIED"
          ]
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_state_free_bytes",
        "min_host_available_memory_bytes",
        "basis"
      ],
      "properties": {
        "min_state_free_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1099511627776
        },
        "min_host_available_memory_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1099511627776
        },
        "basis": {
          "type": "string",
          "enum": [
            "estimated"
          ]
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
