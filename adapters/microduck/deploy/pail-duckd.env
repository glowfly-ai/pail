# /etc/pail/pail-duckd.env — environment for pail-duckd.service (EnvironmentFile=).
# Installed by deploy/install.sh; kept as-is by later installs (like updater.toml upstream).
#
# production is the default and the refusing profile: S27 failed (raw socket open to
# others), S28 (no enforcing gate linked), S29 (no skill table) do not start. `dev` turns
# those into banners — never on a robot that carries a person's intent.
PAIL_PROFILE=production

# The PAIL robot agent (TokenService: GetActiveToken / ReportDecision / Attest).
# unix: socket when the agent runs on the board; http:// only for a dev bench.
PAIL_AGENT_ADDR=unix:/run/pail/agent.sock

# Robot identity as the issuer knows it (robot_registry.yaml).
PAIL_ROBOT_ID=robot-1

# Where libpail_gate finds the sealed policy's keyring trust path — production uses the
# signed bundle; unsigned-dev is refused by the gate in production.
PAIL_KEYRING_MODE=bundle

# Optional NDJSON decision log (the adapter's /pail/gate_state). Under ProtectSystem=strict
# only /run/pail is writable, so keep it there or leave it unset.
PAIL_GATE_LOG=/run/pail/gate.ndjson
