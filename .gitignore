# .gitignore of the public PAIL Core tree.
#
# This file is part of the tree's hygiene, not a convenience: right after `scripts/gen_dev_keys.py`
# runs as the README says, five private-key files would be picked up by `git add -A`. A private key
# committed once stays in the history after deletion and lives on in every clone already made.

.DS_Store
__pycache__/
*.pyc
.venv/

# ---------------------------------------------------------------------------
# Key material. Everything below is generated in each tree and never distributed;
# the job of this list is to keep it from coming back in, not to delete it.
# ---------------------------------------------------------------------------

# Written by scripts/gen_dev_keys.py; it carries the seed, so it is a private key.
config/keys/

# Written by scripts/sros2_provision.sh.
config/grpc_certs/
config/sros2_keystore/
# The fingerprint registry produced together with the certificates. Its fingerprints match
# only the local certificates, so a committed copy is always stale in another tree.
config/robot_registry.yaml

# ---------------------------------------------------------------------------
# Build outputs. Nobody can verify their correspondence to the source, so they are not
# distributed. `go build ./cmd/X` without `-o` writes into a tracked path at the module root.
# ---------------------------------------------------------------------------
bin/
cloud/pail_services
cloud/pail_cloud
cloud/pail_robot_agent
cloud/submit_plan
sdk/grpc_client_go/submit_plan

# Generated gRPC stubs for the Go client (each tree generates them per sdk/grpc_client_go/README.md).
sdk/grpc_client_go/proto/

# The six generated Python gRPC stubs under pvs-public/runner/live/ (*_pb2.py, *_pb2_grpc.py)
# are bundled with this tree and listed in the release manifest, so they are NOT ignored:
# an ignore rule here made `git add -A` drop them from a recipient's clone, and verify_release.py
# then reported them MISSING. Regenerate them only with the pinned toolchain
# (pvs-public/runner/gen_grpc_stubs.md); never edit them by hand.
